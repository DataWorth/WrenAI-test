#!/usr/bin/env bash
set -euo pipefail

ROOT=/opt/wrenai-test
CANONICAL_PROJECT="$ROOT/project"
RUNTIME="$ROOT/runtime"
RESULTS="$ROOT/results"
RUNS="$ROOT/runs"
NETWORK=wrenai-test-net
MYSQL_CONTAINER=wrenai-test-mysql
MCP_CONTAINER=wrenai-test-mcp
CLI_IMAGE=wrenai-test-cli:74bf59e1-relfix1
AGENT_IMAGE=${WRENAI_TEST_AGENT_IMAGE:-wrenai-test-agent:official-30-core-v1}
WREN_HOME="$RUNTIME/wren-home"
CORE_TABLES_FILE="$RUNTIME/crm_30_core_tables.txt"
CORE_DROP_SQL="$RUNTIME/crm_30_core_drop.sql"
BENCHMARK_NAME=crm_30_core_100_qna.jsonl
BENCHMARK_FILE="$ROOT/benchmarks/$BENCHMARK_NAME"

usage() {
  echo "usage: wrenai-testctl preflight | verify-core-30 | reduce-to-core-30 | new-run | generate <project> | enrich <project> | validate <project> | build <project> | start-mcp <project> | generate-benchmark | verify-gold <project> | chatbi-smoke <project> <id> | benchmark <project> | score <project> | status"
}

require_project() {
  project=${1:-}
  test -n "$project"
  test -d "$project/models"
  test -f "$project/wren_project.yml"
  case "$project" in
    "$ROOT"/runs/*/project) ;;
    *) echo "project must be a run-specific project under $RUNS" >&2; exit 2 ;;
  esac
}

mysql_root_query() {
  query=$1
  docker exec "$MYSQL_CONTAINER" sh -lc \
    "MYSQL_PWD=\"\$MYSQL_ROOT_PASSWORD\" mysql -N -B -uroot -e \"$query\""
}

core_table_list_sql() {
  awk 'BEGIN { first=1 } { if (!first) printf ","; printf "\047%s\047", $0; first=0 }' "$CORE_TABLES_FILE"
}

verify_core_30() {
  test -s "$CORE_TABLES_FILE"
  test "$(wc -l < "$CORE_TABLES_FILE" | tr -d ' ')" = 30
  actual_file=$(mktemp /tmp/wrenai-test-core-tables.XXXXXX)
  expected_file=$(mktemp /tmp/wrenai-test-core-expected.XXXXXX)
  trap 'rm -f -- "$actual_file" "$expected_file"' RETURN
  mysql_root_query "SELECT table_name FROM information_schema.tables WHERE table_schema='crm_demo' AND table_type='BASE TABLE' ORDER BY table_name;" > "$actual_file"
  sort "$CORE_TABLES_FILE" > "$expected_file"
  diff -u "$expected_file" "$actual_file"
  table_list=$(core_table_list_sql)
  internal_fk=$(mysql_root_query "SELECT COUNT(*) FROM information_schema.key_column_usage WHERE constraint_schema='crm_demo' AND table_name IN ($table_list) AND referenced_table_name IN ($table_list);")
  references_outside=$(mysql_root_query "SELECT COUNT(*) FROM information_schema.key_column_usage WHERE constraint_schema='crm_demo' AND table_name IN ($table_list) AND referenced_table_name IS NOT NULL AND referenced_table_name NOT IN ($table_list);")
  test "$internal_fk" = 46
  test "$references_outside" = 0
  echo "core_30_ok tables=30 foreign_keys=46"
}

preflight() {
  test -d "$CANONICAL_PROJECT/models"
  test -s "$CANONICAL_PROJECT/.env"
  test -s "$RUNTIME/bailian.env"
  test -s "$WREN_HOME/profiles.yml"
  docker network inspect "$NETWORK" >/dev/null
  docker image inspect "$CLI_IMAGE" >/dev/null
  docker image inspect "$AGENT_IMAGE" >/dev/null
  ! docker ps --format '{{.Names}}' | grep -qx 'wrenai-test-executor'
  test "$(docker inspect -f '{{.State.Status}}' "$MYSQL_CONTAINER")" = running
  verify_core_30
  echo "preflight_ok"
}

reduce_to_core_30() {
  test "${WRENAI_TEST_REDUCE_CONFIRM:-}" = YES || {
    echo "set WRENAI_TEST_REDUCE_CONFIRM=YES after explicit approval" >&2
    exit 2
  }
  test -s "$CORE_DROP_SQL"
  test "$(mysql_root_query "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='crm_demo' AND table_type='BASE TABLE';")" = 55
  ! docker ps --format '{{.Names}}' | grep -Eq '^wrenai-test-(mdl-agent|human-agent|mcp|chatbi-)'
  backup="$ROOT/backups/crm-eight-core-20260807T181432Z/crm_demo.sql"
  test -s "$backup"
  test "$(sha256sum "$backup" | awk '{print $1}')" = 17311c205cdbff54085920d50e523ed613474bfee52ca2ba2f30b88eeb39d143
  mysql_pw=$(docker exec "$MYSQL_CONTAINER" printenv MYSQL_ROOT_PASSWORD)
  docker exec -i -e MYSQL_PWD="$mysql_pw" "$MYSQL_CONTAINER" mysql -uroot < "$CORE_DROP_SQL"
  verify_core_30
  echo "core_30_reduction_ok"
}

new_run() {
  run_id=$(date -u +%Y%m%dT%H%M%SZ)
  run_root="$RUNS/$run_id"
  run_project="$run_root/project"
  result_dir="$RESULTS/$run_id"
  test ! -e "$run_root"
  mkdir -p "$run_root" "$result_dir"
  cp -a "$CANONICAL_PROJECT" "$run_project"
  chown -R 10001:10001 "$run_root" "$result_dir"
  echo "$run_project"
}

generate() {
  project=$1
  require_project "$project"
  run_id=$(basename "$(dirname "$project")")
  result_dir="$RESULTS/$run_id"
  mkdir -p "$result_dir"
  docker rm -f wrenai-test-mdl-agent >/dev/null 2>&1 || true
  docker run --rm -i --name wrenai-test-mdl-agent \
    --network "$NETWORK" \
    --env-file "$RUNTIME/bailian.env" \
    --env-file "$CANONICAL_PROJECT/.env" \
    -e WRENAI_TEST_USER_REQUEST="${WRENAI_TEST_USER_REQUEST:-请为当前连接的 CRM 数据库搭建 MDL。}" \
    -e WRENAI_TEST_TRANSCRIPT=/results/generate-mdl-transcript.jsonl \
    -v "$project:/workspace:rw" \
    -v "$result_dir:/results:rw" \
    "$AGENT_IMAGE" /app/wrenai-test-mdl-agent.mjs \
    2>&1 | tee "$result_dir/generate-mdl.log"
}

enrich() {
  project=$1
  require_project "$project"
  run_id=$(basename "$(dirname "$project")")
  result_dir="$RESULTS/$run_id"
  mkdir -p "$result_dir"
  docker rm -f wrenai-test-human-agent >/dev/null 2>&1 || true
  docker run --rm -i --name wrenai-test-human-agent \
    --network "$NETWORK" \
    --env-file "$RUNTIME/bailian.env" \
    --env-file "$CANONICAL_PROJECT/.env" \
    -e WRENAI_TEST_USER_REQUEST="${WRENAI_TEST_USER_REQUEST:-请用 Grill 模式补充当前 CRM 项目的业务语义，每次只问一个问题。}" \
    -e WRENAI_TEST_TRANSCRIPT=/results/human-grill-transcript.jsonl \
    -v "$project:/workspace:rw" \
    -v "$result_dir:/results:rw" \
    "$AGENT_IMAGE" /app/wrenai-test-human-agent.mjs \
    2>&1 | tee "$result_dir/enrich-context.log"
}

run_context_command() {
  command=$1
  project=$2
  require_project "$project"
  docker run --rm --network "$NETWORK" \
    --env-file "$CANONICAL_PROJECT/.env" \
    -e WREN_HOME=/wren-home \
    -v "$project:/workspace:rw" \
    -v "$WREN_HOME:/wren-home:ro" \
    -w /workspace \
    "$CLI_IMAGE" context "$command"
}

start_mcp() {
  project=$1
  require_project "$project"
  test -s "$project/target/mdl.json"
  docker rm -f "$MCP_CONTAINER" >/dev/null 2>&1 || true
  docker run -d --name "$MCP_CONTAINER" \
    --network "$NETWORK" \
    --env-file "$CANONICAL_PROJECT/.env" \
    -e WREN_HOME=/wren-home \
    -v "$project:/workspace:ro" \
    -v "$WREN_HOME:/wren-home:ro" \
    "$CLI_IMAGE" serve mcp --transport http --host 0.0.0.0 --port 8080 \
    --project /workspace --profile wrenai-test-mysql --quiet >/dev/null
  echo "mcp_started"
}

generate_benchmark() {
  docker run --rm --network "$NETWORK" \
    --env-file "$CANONICAL_PROJECT/.env" \
    -v "$RUNTIME/benchmark.py:/app/benchmark.py:ro" \
    -v "$ROOT/benchmarks:/benchmarks:rw" \
    "$CLI_IMAGE" python3 /app/benchmark.py generate crm_30_core
  test "$(wc -l < "$BENCHMARK_FILE" | tr -d ' ')" = 100
}

run_score() {
  project=$1
  result_dir=$2
  only_id=${3:-}
  require_project "$project"
  model=$(awk -F= '$1=="ANTHROPIC_MODEL" {print $2}' "$RUNTIME/bailian.env")
  score_args=(python3 /app/score.py --benchmark "/benchmarks/$BENCHMARK_NAME" --results /results --workspace /workspace)
  if test -n "$only_id"; then score_args+=(--only "$only_id"); fi
  docker run --rm --network "$NETWORK" \
    --env-file "$CANONICAL_PROJECT/.env" \
    -e WREN_HOME=/wren-home \
    -e ANTHROPIC_MODEL="$model" \
    -e WRENAI_TEST_BENCHMARK="/benchmarks/$BENCHMARK_NAME" \
    -v "$RUNTIME/score.py:/app/score.py:ro" \
    -v "$BENCHMARK_FILE:/benchmarks/$BENCHMARK_NAME:ro" \
    -v "$project:/workspace:ro" \
    -v "$result_dir:/results:rw" \
    -v "$WREN_HOME:/wren-home:ro" \
    "$CLI_IMAGE" "${score_args[@]}"
}

verify_gold() {
  project=$1
  require_project "$project"
  docker run --rm --network "$NETWORK" \
    --env-file "$CANONICAL_PROJECT/.env" \
    -e WREN_HOME=/wren-home \
    -e WRENAI_TEST_BENCHMARK="/benchmarks/$BENCHMARK_NAME" \
    -v "$RUNTIME/score.py:/app/score.py:ro" \
    -v "$BENCHMARK_FILE:/benchmarks/$BENCHMARK_NAME:ro" \
    -v "$project:/workspace:ro" \
    -v "$WREN_HOME:/wren-home:ro" \
    "$CLI_IMAGE" python3 /app/score.py --benchmark "/benchmarks/$BENCHMARK_NAME" --workspace /workspace --verify-gold
}

chatbi_container() {
  project=$1
  result_dir=$2
  identifier=$3
  name=$4
  require_project "$project"
  test "$(docker inspect -f '{{.State.Status}}' "$MCP_CONTAINER")" = running
  docker rm -f "$name" >/dev/null 2>&1 || true
  docker run --rm --name "$name" \
    --network "$NETWORK" \
    --env-file "$RUNTIME/bailian.env" \
    -e WRENAI_TEST_BENCHMARK="/benchmarks/$BENCHMARK_NAME" \
    -v "$BENCHMARK_FILE:/benchmarks/$BENCHMARK_NAME:ro" \
    -v "$project:/workspace:ro" \
    -v "$result_dir:/results:rw" \
    "$AGENT_IMAGE" /app/chatbi-eval.mjs "$identifier"
}

chatbi_smoke() {
  project=$1
  identifier=$2
  run_id=$(basename "$(dirname "$project")")
  result_dir="$RESULTS/$run_id/chatbi-smoke"
  mkdir -p "$result_dir"
  chown -R 10001:10001 "$result_dir"
  chatbi_container "$project" "$result_dir" "$identifier" wrenai-test-chatbi-smoke 2>&1 | tee "$result_dir/chatbi-smoke.log"
  test -s "$result_dir/$identifier.json"
  run_score "$project" "$result_dir" "$identifier"
}

benchmark() {
  project=$1
  run_id=$(basename "$(dirname "$project")")
  result_dir="$RESULTS/$run_id/chatbi-benchmark"
  mkdir -p "$result_dir"
  chown -R 10001:10001 "$result_dir"
  for identifier in $(seq 1 100); do
    if test -s "$result_dir/$identifier.json"; then
      continue
    fi
    if ! chatbi_container "$project" "$result_dir" "$identifier" "wrenai-test-chatbi-$identifier" >> "$result_dir/chatbi-benchmark.log" 2>&1; then
      printf 'chatbi_question_failed id=%s\n' "$identifier" >> "$result_dir/chatbi-benchmark.log"
    fi
    test -s "$result_dir/$identifier.json"
  done
  run_score "$project" "$result_dir"
}

score() {
  project=$1
  run_id=$(basename "$(dirname "$project")")
  run_score "$project" "$RESULTS/$run_id/chatbi-benchmark"
}

status() {
  docker ps -a --format '{{.Names}}|{{.Image}}|{{.Status}}' | awk -F'|' '$1 ~ /^wrenai-test-/ {print}' | sort
}

command=${1:-}
case "$command" in
  preflight) preflight ;;
  verify-core-30) verify_core_30 ;;
  reduce-to-core-30) reduce_to_core_30 ;;
  new-run) new_run ;;
  generate) require_project "${2:-}"; generate "$2" ;;
  enrich) require_project "${2:-}"; enrich "$2" ;;
  validate) run_context_command validate "${2:-}" ;;
  build) run_context_command build "${2:-}" ;;
  start-mcp) start_mcp "${2:-}" ;;
  generate-benchmark) generate_benchmark ;;
  verify-gold) verify_gold "${2:-}" ;;
  chatbi-smoke) chatbi_smoke "${2:-}" "${3:-}" ;;
  benchmark) benchmark "${2:-}" ;;
  score) score "${2:-}" ;;
  status) status ;;
  *) usage; exit 2 ;;
esac
