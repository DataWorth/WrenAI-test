FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY evals/wren_agent_crm/runtime/package.json ./
RUN npm config set registry https://registry.npmmirror.com && npm install --omit=dev && npm cache clean --force
RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin agent
COPY --chown=agent:agent \
    evals/wren_agent_crm/runtime/agent-common.mjs \
    evals/wren_agent_crm/runtime/semantic-agent.mjs \
    evals/wren_agent_crm/runtime/chatbi-agent.mjs \
    evals/wren_agent_crm/runtime/chatbi-eval.mjs \
    ./
RUN mkdir -p /home/agent/.claude/skills/generate-mdl && chown -R agent:agent /home/agent/.claude
COPY --chown=agent:agent core/wren/src/wren/skills_content/generate-mdl/SKILL.md /home/agent/.claude/skills/generate-mdl/SKILL.md
USER agent
ENTRYPOINT ["node"]
